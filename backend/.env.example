# Copy to backend/.env. Never commit .env.
# Write KEY=value with no quotes needed. Put comments on their own line (a ' #' after a value also works).
FIRMS_KEY=your_nasa_firms_map_key
# For scripts and operators calling the API directly (and the default signing secret). The website never asks for it.
# People use the site by signing in; create the first administrator with: python make_admin.py --name ... --channel email --contact ...
ADMIN_TOKEN=choose_a_long_random_token_16+_chars
ALERT_LANG=English
# Scope: city (default) watches one BBOX and one target city. india pulls every detection in India from NASA FIRMS (country query IND),
# keeps the biggest clusters nationwide (MAX_CLUSTERS, default 25) and judges each against its nearest major city (see cities.py).
# SCOPE=india
# india scope: ignore alternatives farther than this many km from a cluster
# ALT_MAX_KM=250
# Region to watch and the city to protect (city scope) (see config.py for defaults). Optional display names:
# BBOX=west,south,east,north
# CITY_LAT=28.6
# CITY_LON=77.2
# CITY_NAME=
# REGION_NAME=

# Delivery: log = record only (test mode, shows codes on screen), live = really send
DELIVERY=log
AUTO_ALERT=0
REFRESH_HOURS=3
# SMS uses Amazon SNS (needs AWS credentials). Email uses SMTP, or Amazon SES with EMAIL_PROVIDER=ses
# EMAIL_PROVIDER=ses
# SES_FROM=verified-sender@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# AI model: pick ONE provider
# 1) Amazon Bedrock (default)
# MODEL_PROVIDER=bedrock
# MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
# AWS_REGION=us-west-2
# 2) Gemini via OpenAI-compatible API
# MODEL_PROVIDER=openai
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_ID=gemini-2.5-flash
# MODEL_API_KEY=your_key
# 3) Ollama (local, free)
# MODEL_PROVIDER=ollama
# MODEL_ID=llama3.1

# Storage: sqlite (local file, default) or dynamodb (AWS: DynamoDB tables + S3 snapshot)
# STORE=dynamodb
# DDB_PREFIX=nabhonetra
# STORE_REGION=us-west-2
# SNAPSHOT_BUCKET=your-bucket
# Demo subscribers (python seed_demo.py) are never messaged; set 1 to show them in totals for a demo
# INCLUDE_DEMO=0
# Set when running behind a load balancer or App Runner
# TRUST_PROXY=1
# Caps verification messages per day (cost protection)
# OTP_DAILY_MAX=300
# Contact email sent to OpenStreetMap place lookups (their usage policy asks for it)
# CONTACT_EMAIL=you@example.com

# Agent tuning (all optional)
# Drop fires weaker than this many MW (0 keeps all)
# MIN_FRP=0
# A spot seen on this many different days is treated as an industrial heat source (0 turns it off)
# STATIC_DAYS=3
# Wind forecast window (hours) used to judge whether smoke reaches the city
# FORECAST_HOURS=24
# Smoke counts as reaching the city within this distance (km)
# SMOKE_REACH_KM=30
# Automatic alerts only go out in this UTC hour range (1-7 is morning in UTC+5:30)
# ALERT_WINDOW_UTC=0-24
# AI alert text on (1) or templates only (0)
# USE_AGENT=1
# Days of fire history to pull (1-5), and the most clusters kept (default 15, or 25 with SCOPE=india)
# DAY_RANGE=3
# MAX_CLUSTERS=15
# Smoke drifts slower than the wind: this fraction of wind speed (default 0.8)
# SMOKE_SPEED_FACTOR=0.8

# Interventions: response links sent to providers and buyers need the public address of your site
# PUBLIC_URL=https://your-site.example
# Only when the website is hosted at a different address than the API (for example AWS Amplify): the website address(es) allowed to call the API, comma separated. https only; * is ignored.
# CORS_ORIGINS=https://main.xxxx.amplifyapp.com
# Signs response links and sign-in sessions (defaults to ADMIN_TOKEN). Leave unset to reuse ADMIN_TOKEN.
# TOKEN_SECRET=some_other_long_random_string
# WhatsApp (optional, via AWS End User Messaging Social; needs an approved WhatsApp Business account)
# WHATSAPP_PHONE_ID=phone-number-id-...
# Approved template name with one body variable (recommended for first contact)
# WHATSAPP_TEMPLATE=your_template_name
