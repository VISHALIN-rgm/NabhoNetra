# Frontend settings. Everything starting with VITE_ is bundled into the website and visible to anyone, so never put a secret here.
# Address of the API when the website is hosted separately (Amplify). Leave empty to use the same address as the website.
# VITE_API_URL=https://xxxx.us-west-2.awsapprunner.com
# Optional: read dashboard data from a static JSON file instead of the API.
# VITE_DATA_URL=
